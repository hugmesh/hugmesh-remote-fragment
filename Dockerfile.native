# hugmesh-remote-fragment SYNC SIDECAR, GraalVM native build.
#
# The same service as ./Dockerfile (the JVM image the deployments run), compiled to
# a native binary by the pom's `native` profile. Published as an extra artifact,
# ghcr.io/hugmesh/hugmesh-remote-fragment/native. Same port (8081), same
# environment, same config resolution. scripts/native-build.sh (`make native`, CI
# build:native) compiles and smoke-tests the identical binary.
#
# Toolchain: GraalVM CE 25.0.2, pinned by digest, for Java4Shell (CVE-2026-114938).
# GraalVM's compiler ported HotSpot's AVX-512 Base64 decode stub
# (oracle/graal 040cfd0a8a, 2026-03-24), and SubstrateVM compiles it into amd64
# native images. The fix (oracle/graal 13a4853144, GR-79579) is on master only, and
# every GraalVM 25 Innovation release through 25.5.5.0.3 still ships the unfixed
# stub. 25.0.2 predates the port. The guard below refuses any other toolchain until
# one is confirmed to contain GR-79579 (same allowlist as scripts/native-build.sh).
FROM ghcr.io/graalvm/graalvm-community:25@sha256:7eeb80438dcda5edfcc58e804ce919018d2bf40ef61ddbb555936a8ba2a216aa AS build
RUN grep -qx 'GRAALVM_VERSION="25.0.2"' "${JAVA_HOME}/release" \
    || { echo "GraalVM $(sed -n 's/^GRAALVM_VERSION=//p' "${JAVA_HOME}/release") is not on the Java4Shell (CVE-2026-114938) allowlist; see the comment above" >&2; exit 1; }
WORKDIR /work
# Same registry coordinates and credential paths as ./Dockerfile (see its comments):
# GitLab group registry through settings.xml, or GitHub Packages through
# .github/maven-ci-settings.xml when the packages_read_token secret is mounted.
ARG CI_API_V4_URL
ARG GITLAB_GROUP_ID
ENV CI_API_V4_URL=${CI_API_V4_URL} \
    GITLAB_GROUP_ID=${GITLAB_GROUP_ID}
# Passed to native-image (GraalVM reads NATIVE_IMAGE_OPTIONS). The default matches
# `make native` and CI build:native. Empty means native-image's default heap (80% of RAM).
ARG NATIVE_IMAGE_OPTIONS=-J-Xmx6g
ENV NATIVE_IMAGE_OPTIONS=${NATIVE_IMAGE_OPTIONS}
COPY . .
ARG UPSTREAM_PACKAGES_ACTOR=github-actions
# `set -x` is deliberately absent: it would echo the exported token into the build log.
RUN --mount=type=secret,id=ci_job_token \
    --mount=type=secret,id=packages_read_token \
    sh -euc '\
      settings=settings.xml; \
      if [ -e /run/secrets/packages_read_token ]; then \
        if [ ! -s /run/secrets/packages_read_token ]; then \
          echo "FATAL: secret packages_read_token is mounted but empty (is PACKAGES_READ_TOKEN set?)" >&2; \
          exit 1; \
        fi; \
        UPSTREAM_PACKAGES_TOKEN="$(cat /run/secrets/packages_read_token)"; \
        export UPSTREAM_PACKAGES_TOKEN UPSTREAM_PACKAGES_ACTOR; \
        settings=.github/maven-ci-settings.xml; \
      elif [ -f /run/secrets/ci_job_token ]; then \
        CI_JOB_TOKEN="$(cat /run/secrets/ci_job_token)"; \
        export CI_JOB_TOKEN; \
      fi; \
      echo "maven settings: ${settings}"; \
      ./mvnw -B -s "${settings}" -Pnative -DskipTests native:compile'

# Runtime: glibc + CA certificates for the native binary. curl is for the compose
# HEALTHCHECK on /actuator/health/readiness, as in ./Dockerfile.
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /work/target/remote-fragment /app/remote-fragment
# Actuator listens on 8081 in-pod (nginx owns 8080); SERVER_PORT overrides.
EXPOSE 8081
ENTRYPOINT ["/app/remote-fragment"]
